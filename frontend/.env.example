# All development, demonstration and production pages use the Python API.
VITE_API_BASE_URL=/api/v1
# Local Vite proxy target. Restart Vite after changing this value.
API_PROXY_TARGET=http://127.0.0.1:8000
# Enable only after BE-56 deploys the content.sourceUrl contract.
VITE_OPPORTUNITY_SOURCE_URLS=false
