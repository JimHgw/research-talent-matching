# Reference only: export these variables in the backend process environment.
# Flask does not automatically load this file in this project.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=h18abanana
MYSQL_USER=banana
MYSQL_PASSWORD=banana_local_password
# Alternatively export DATABASE_URL=mysql+pymysql://user:password@host:3306/database?charset=utf8mb4
# Legacy SQLite is supported only when explicitly selected, including migration sources/tests.
# DATABASE_URL=sqlite:///data/h18abanana.db
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local HTTP only. The application defaults to true for HTTPS.
COOKIE_SECURE=false
# Email registration requires a working SMTP service; export these variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
# Export the same storage/database settings in both API and worker terminals.
DOCUMENT_STORAGE_DIR=data/documents
DOCUMENT_PROCESSING_TIMEOUT=300
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
