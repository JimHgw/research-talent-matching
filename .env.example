# Optional Docker overrides: copy this file to .env in the repository root.
# The launcher works without copying it. Shell variables take precedence.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Set true after deploying the US-19 sourceUrl API, then rebuild frontend.
VITE_OPPORTUNITY_SOURCE_URLS=false
# MySQL 8.4. These defaults are for local development; change both passwords for deployment.
MYSQL_DATABASE=h18abanana
MYSQL_USER=banana
MYSQL_PASSWORD=banana_local_password
MYSQL_ROOT_PASSWORD=banana_local_root_password
# Used only by compose.mysql-local.yaml for native backend development.
MYSQL_PORT=3306
# Optional external database URL; URL-encode credentials. Normally use MYSQL_* above.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database?charset=utf8mb4
# Local HTTP development only. Use true behind HTTPS in a production deployment.
COOKIE_SECURE=false
# When changing FRONTEND_PORT, update both allowed browser origins as well.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# SMTP for verified-email registration. Set real values only in ignored .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
# Persistent worker claim deadline (seconds) and maximum attempts.
DOCUMENT_PROCESSING_TIMEOUT=300
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
# Score individual requirements, then average with REQUIRED=2 / PREFERRED=1 weights.
SEMANTIC_MATCHING_ENABLED=true
# Retained for configuration compatibility; no longer adds a global interest bonus.
SEMANTIC_MATCHING_WEIGHT=0.3
# Native development default; the Docker image bundles its own verified model.
# SEMANTIC_MODEL_DIR=data/semantic/model
